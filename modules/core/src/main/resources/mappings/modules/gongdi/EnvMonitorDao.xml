<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  工地环境监测（噪声扬尘）查询
  数据源：gongdi（ZHGD_2，只读账号）
  注意：本文件只允许出现 SELECT，严禁写操作。
-->
<mapper namespace="com.jeesite.modules.gongdi.dao.EnvMonitorDao">

	<!-- 项目 + 设备联合结果（一行对应一台设备） -->
	<resultMap id="envMonitorMap" type="com.jeesite.modules.gongdi.entity.EnvMonitorVo">
		<result property="engineeringId" column="engineeringId"/>
		<result property="engineeringName" column="engineeringName"/>
		<result property="lng" column="lng"/>
		<result property="lat" column="lat"/>
		<result property="address" column="address"/>
		<result property="accessDeviceId" column="accessDeviceId"/>
		<result property="deviceNo" column="deviceNo"/>
		<result property="deviceName" column="deviceName"/>
		<result property="monitorPlace" column="monitorPlace"/>
		<result property="deviceStatus" column="deviceStatus"/>
		<result property="isOnline" column="isOnline"/>
	</resultMap>

	<!-- 明细结果 -->
	<resultMap id="envRecordMap" type="com.jeesite.modules.gongdi.entity.EnvRecord">
		<result property="accessDeviceId" column="accessDeviceId"/>
		<result property="noise" column="noise"/>
		<result property="temp" column="temp"/>
		<result property="humid" column="humid"/>
		<result property="tsp" column="tsp"/>
		<result property="recordTime" column="recordTime"/>
	</resultMap>

	<!--
	  项目 + 环境监测设备（DEVICE_TYPE = 1）
	  用 INNER JOIN 而非两次查询：既省一次往返，
	  也保证"设备所属项目已删除"的行不会出现（否则会出现设备有值、项目名称为空的行）。
	-->
	<select id="findProjectDevices" resultMap="envMonitorMap">
		SELECT e.ENGINEERING_ID AS "engineeringId",
		       e.NAME           AS "engineeringName",
		       e.LNG            AS "lng",
		       e.LAT            AS "lat",
		       e.ADDRESS        AS "address",
		       d.ACCESS_DEVICE_ID AS "accessDeviceId",
		       d.DEVICE_NO        AS "deviceNo",
		       d.DEVICE_NAME      AS "deviceName",
		       d.MONITOR_PLACE    AS "monitorPlace",
		       d.DEVICE_STATUS    AS "deviceStatus",
		       d.IS_ONLINE        AS "isOnline"
		FROM T_ENGINEERING e
		INNER JOIN T_ACCESS_DEVICE d ON d.ENGINEERING_ID = e.ENGINEERING_ID
		WHERE e.IS_DELETE = 0
		  AND d.IS_DELETE = 0
		  AND d.DEVICE_TYPE = 1
		  AND e.ENGINEERING_ID IN
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
		ORDER BY e.ENGINEERING_ID, d.ACCESS_DEVICE_ID
	</select>

	<!--
	  某台设备的最新一条监测记录（动态表名，逐设备调用）

	  按主键倒序取 1 条，走主键索引。前提是「主键最大即采集时间最新」，
	  正常顺序写入时成立；若出现补录 / 回溯导入 / 多源写入，会取到偏早的一条且不会报错。
	  ${tableName} 由 Service 用纯数字白名单校验后拼接，无注入面。
	-->
	<select id="findLatestRecord" resultMap="envRecordMap">
		SELECT ACCESS_DEVICE_ID AS "accessDeviceId",
		       NOISE            AS "noise",
		       TEMP             AS "temp",
		       HUMID            AS "humid",
		       TSP              AS "tsp",
		       TO_CHAR(RECORD_TIME, 'YYYY-MM-DD HH24:MI:SS') AS "recordTime"
		FROM ${tableName}
		WHERE ACCESS_DEVICE_ID = #{deviceId}
		  AND IS_DELETE = 0
		  AND RECORD_TIME IS NOT NULL
		ORDER BY ENVIRONMENTAL_RECORD_ID DESC
		FETCH FIRST 1 ROWS ONLY
	</select>

</mapper>
